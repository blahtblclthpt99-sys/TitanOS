# TitanOS production / packaging template.
# Never commit real keys. Production values are injected by the deployment environment.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Canonical public HTTPS origin for TitanOS web authentication and native fallback routing.
# Example shape only: https://app.example.com
# Do not point these values at retired Vercel hosts.
VITE_TITANOS_PUBLIC_ORIGIN=

# Web builds use same-origin /api routing when this is blank.
# Native/Capacitor production builds MUST set this to the final TitanOS HTTPS origin.
VITE_API_BASE_URL=

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Cloudflare Worker public runtime configuration.
# APP_ORIGIN must equal the canonical TitanOS HTTPS origin exactly.
APP_ORIGIN=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only secrets — provision in Cloudflare; never ship these to the browser.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ATTENTION_STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# SEED_MARKETPLACE_SECRET=
