{
  "name": "titanos",
  "engines": {
    "node": ">=20 <25"
  },
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p ./tsconfig.json --pretty false",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:share": "powershell -ExecutionPolicy Bypass -File scripts/prepare-apk-share.ps1",
    "android:sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-android-release.ps1",
    "ionos:package": "powershell -ExecutionPolicy Bypass -File scripts/package-ionos-web.ps1",
    "dealforge:package": "powershell -ExecutionPolicy Bypass -File dealnest/scripts/package-website.ps1",
    "cap:sync": "npm run build && npx cap sync android",
    "supabase:check": "node scripts/check-supabase-setup.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "ops:load": "node scripts/load-test.mjs",
    "ops:load:smoke": "node scripts/load-test.mjs --profile smoke",
    "ops:load:spike": "node scripts/load-test.mjs --profile spike",
    "ops:payments": "node scripts/payment-failure-scenarios.mjs",
    "ops:backup": "node scripts/backup-restore-drill.mjs --export",
    "ops:outage": "node scripts/outage-recovery-drill.mjs",
    "ops:readiness": "node scripts/payment-failure-scenarios.mjs && node scripts/backup-restore-drill.mjs --export && node scripts/outage-recovery-drill.mjs && node scripts/load-test.mjs --profile storm",
    "test:fees": "node --test scripts/fee-engine.test.mjs",
    "test:hire": "node --test scripts/hire-security.test.mjs",
    "test:payments": "node --test scripts/payment-security.test.mjs scripts/stripe-webhook-policy.test.mjs",
    "test:driver": "node --test scripts/driver-hub.test.mjs scripts/vehicle-capacity.test.mjs",
    "test:money": "node --test scripts/money-document.test.mjs scripts/portal-otp.test.mjs",
    "test:tax": "node --test scripts/tax-engine.test.mjs",
    "test:hardening": "node --test scripts/production-hardening.test.mjs",
    "test:auth": "node --test scripts/auth-guards.test.mjs",
    "test:db-security": "node scripts/verify-db-security.mjs",
    "test": "npm run test:fees && npm run test:hire && npm run test:payments && npm run test:driver && npm run test:money && npm run test:tax && npm run test:auth && npm run test:hardening"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.4",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  }
}
