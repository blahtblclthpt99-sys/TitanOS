# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. Set the same VITE_* values in Vercel → Settings → Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

VITE_TITANOS_PUBLIC_ORIGIN=https://titanos-web.vercel.app
VITE_API_BASE_URL=https://titanos-web.vercel.app

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Server-only (set in Vercel; never ship to the browser)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# SEED_MARKETPLACE_SECRET=
