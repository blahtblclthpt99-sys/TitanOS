# Fail closed when a dependency introduces an unreviewed install-time script.
strict-allow-scripts=true

# Reviewed install scripts required by the current locked dependency graph.
# Keep these version-pinned; upgrades require explicit re-review.
# Wrangler's npx-only toolchain is pinned here too so Cloudflare dry-runs remain fail-closed.
allow-scripts=@sentry/node-cpu-profiler@2.4.2,esbuild@0.25.12,esbuild@0.28.1,workerd@1.20260617.1,sharp@0.34.5
