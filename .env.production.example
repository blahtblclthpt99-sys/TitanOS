# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. For Cloudflare preview/production builds, provide these
# values through the deployment platform or CI secret/variable store.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Canonical public app origin. Replace with the final TitanOS custom domain at cutover.
VITE_TITANOS_PUBLIC_ORIGIN=https://YOUR_TITANOS_DOMAIN

# Leave blank for normal web deployments so browser API calls use same-origin /api.
# Set only for native/mobile shells or deliberate cross-origin API routing.
VITE_API_BASE_URL=

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Cloudflare Worker server-only bindings for the migrated Titan Attention payment edge.
# Provision these as Worker secrets/bindings; never prefix them with VITE_.
# APP_ORIGIN must be the final clean HTTPS TitanOS production origin at cutover.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_ORIGIN=

# Other backend-only secrets belong only on the runtime that owns the corresponding
# certified route. Do not copy legacy secrets into Cloudflare unless that route has
# explicitly migrated and requires them.
# RESEND_API_KEY=
# SEED_MARKETPLACE_SECRET=
