# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. Set the same values in Vercel → Settings → Environment Variables.

# ─── TitanOS surface ──────────────────────────────────────────────────────────
# Explicitly keep this project on TitanOS / Autopilot, not Titan Attention.
VITE_APP_SURFACE=titanos

# ─── Supabase client (required) ───────────────────────────────────────────────
# Browser values. The publishable/anon values are public by design.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# ─── Public URLs ──────────────────────────────────────────────────────────────
VITE_TITANOS_PUBLIC_ORIGIN=https://titanos-web.vercel.app
VITE_API_BASE_URL=https://titanos-web.vercel.app

# ─── Server-only Supabase (required for TitanOS APIs) ─────────────────────────
# SUPABASE_URL must point to the SAME canonical project as VITE_SUPABASE_URL.
# api/_lib/supabase.js fails closed when canonical project refs disagree.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Product-owned email (required for production signup + Autopilot delivery) ─
# Production signup uses Titan's own OTP delivery path. runAutopilotFree also
# fails closed when the email provider is not configured.
RESEND_API_KEY=re_...
RESEND_FROM=TitanOS <noreply@yourdomain.com>

# Optional: production defaults to requiring email confirmation unless explicitly
# disabled. Keep true for Product Hunt / public launch certification.
REGISTER_REQUIRE_EMAIL_CONFIRM=true

# ─── Observability (optional) ─────────────────────────────────────────────────
VITE_SENTRY_DSN=
SENTRY_DSN=

# ─── Attention / other payment surfaces only ─────────────────────────────────
# Titan Autopilot is free and does NOT require Stripe. Do not add an Autopilot
# price, Checkout flag, or paid-plan entitlement here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional service integrations
# SEED_MARKETPLACE_SECRET=
