# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. Browser builds on Cloudflare use same-origin `/api` by default.
# Native/packaged builds must set VITE_API_BASE_URL to the final production HTTPS origin.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

VITE_TITANOS_PUBLIC_ORIGIN=https://YOUR_PRODUCTION_ORIGIN
VITE_API_BASE_URL=https://YOUR_PRODUCTION_ORIGIN

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Worker/server-only secrets — configure as Cloudflare Worker secrets/vars;
# never expose these through VITE_* variables or ship them to the browser.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# SEED_MARKETPLACE_SECRET=

# Explicit server-side release/launch truth.
# APP_LATEST_VERSION=2.0.0
# APP_MINIMUM_VERSION=2.0.0
# MEMBERSHIP_PAYMENTS_LIVE=false
# TITANOS_PUBLIC_ORIGIN=https://YOUR_PRODUCTION_ORIGIN
# CORS_ALLOWED_ORIGINS=https://YOUR_PRODUCTION_ORIGIN
