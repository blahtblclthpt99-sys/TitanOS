# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. Set public values and server secrets in Cloudflare Pages.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

VITE_TITANOS_PUBLIC_ORIGIN=https://titanfieldos.com
VITE_API_BASE_URL=https://titanfieldos.com

# Web/PWA ad monetization. Slot IDs come from AdSense; never invent them.
VITE_ADSENSE_ENABLED=true
VITE_ADSENSE_CLIENT=ca-pub-7224659901194043
VITE_ADSENSE_SLOT_BUSINESS_HOME=
VITE_ADSENSE_SLOT_JOB_FEED=
VITE_ADSENSE_SLOT_INDEPENDENT_HOME=
VITE_ADSENSE_SLOT_INDEPENDENT_FEED=

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Server-only Cloudflare Pages secrets/bindings — never ship to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# OPENAI_API_KEY=
# REGISTER_REQUIRE_EMAIL_CONFIRM=true
# PORTAL_OTP_PEPPER=
# HEALTH_DEEP_SECRET=
# APP_ORIGIN=https://titanfieldos.com
