{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "titanos",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
