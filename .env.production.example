# Production / packaging template — copy to `.env.production` locally if needed.
# Never commit real keys. Set VITE_* build variables in Cloudflare and server-only values as Worker secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Canonical Cloudflare-hosted production origin.
VITE_TITANOS_PUBLIC_ORIGIN=https://titanos.app
VITE_API_BASE_URL=https://titanos.app
PUBLIC_APP_URL=https://titanos.app

# Observability (optional — client + server no-op when unset)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Server-only Cloudflare Worker secrets — never ship to the browser.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# SEED_MARKETPLACE_SECRET=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# OPENAI_API_KEY=
