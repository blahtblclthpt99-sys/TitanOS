# Copy to .env.local and restart the dev server after changes.

# ─── Supabase (required) ───────────────────────────────────────────────────────
# TitanOS is Vite (not Next.js). Use VITE_* — not NEXT_PUBLIC_*.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Legacy JWT anon key OR new sb_publishable_… key both work:
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias (same value as above):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Cloudflare Pages secrets/bindings — never expose in frontend.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_ACCESS_TOKEN=sbp_...   # optional; enables scripts/fix-supabase-auth.mjs
# RESEND_API_KEY=re_...
# RESEND_FROM=TitanOS <noreply@yourdomain.com>
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional external job search provider (server-only; never VITE_*).
# Titan-native matching works without these. External results are queried only
# after the signed-in user explicitly enables outside-job search.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Canonical public site/API URL. Titan APIs are same-origin on Cloudflare Pages.
VITE_TITANOS_PUBLIC_ORIGIN=https://titanfieldos.com
VITE_API_BASE_URL=https://titanfieldos.com
# APP_ORIGIN=https://titanfieldos.com
# PUBLIC_APP_URL=https://titanfieldos.com

# Google OAuth: enable in Supabase Dashboard (see GOOGLE_AUTH.md).
# Never put Google Client Secret in VITE_* vars — only in Supabase Auth settings.

# Optional web/PWA advertising (Google AdSense).
# Configure these only after the site is approved by the ad provider and
# consent/privacy messaging is configured. Paid plans remain ad-free. Native
# Capacitor builds intentionally suppress this web ad path until a policy-
# compliant AdMob/WebView integration is configured.
# TitanOS publisher: pub-7224659901194043
# VITE_ADSENSE_ENABLED=true
# VITE_ADSENSE_CLIENT=ca-pub-7224659901194043
# VITE_ADSENSE_SLOT_BUSINESS_HOME=0000000000
# VITE_ADSENSE_SLOT_JOB_FEED=0000000000
# VITE_ADSENSE_SLOT_INDEPENDENT_HOME=0000000000
# VITE_ADSENSE_SLOT_INDEPENDENT_FEED=0000000000

# Optional Stripe — server secrets are Cloudflare Pages secrets, never VITE_*.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Server-only Stripe Price for the $9 Titan Autopilot Invoice Recovery Sprint.
# STRIPE_AUTOPILOT_PRICE_ID=price_...
# VITE_AUTOPILOT_ONETIME_CHECKOUT=false
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# Machine Payments Protocol (MPP) — /api/functions/mppPaid
# STRIPE_PROFILE_ID=profile_...
# MPP_SECRET_KEY=  # openssl rand -base64 32
# MPP_TESTNET=1
# MPP_TEMPO_AMOUNT=0.01
# MPP_STRIPE_AMOUNT=0.50
# MPP_STRICT_CACHE=0

# Production registration requires email confirmation unless explicitly disabled.
# REGISTER_REQUIRE_EMAIL_CONFIRM=true

# Portal OTP pepper (server-only — prefer dedicated random string, not service role)
# PORTAL_OTP_PEPPER=long-random-string
# Legacy OTP/token compatibility is disabled by default. Only enable temporarily
# during a controlled migration window, then remove/disable again.
# PORTAL_OTP_ALLOW_LEGACY=0
# PORTAL_TOKEN_ALLOW_LEGACY=0

# Deep health (?deep=1) — header x-titanos-ops only
# HEALTH_DEEP_SECRET=long-random-string

# Optional Sentry (observability)
# Client (Vite): only set if you want browser error reporting
# VITE_SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0
# Server: prefer dedicated server DSN; falls back to VITE_SENTRY_DSN where supported
# SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# Enable temporary verification route GET /api/functions/sentryDebug
# SENTRY_DEBUG_ROUTE=1
# Opt-in Node CPU profiling only on runtimes that support the native addon.
# SENTRY_PROFILING=0

# Optional TitanCom TURN (comma-separated URLs). Improves PTT through hard NATs.
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
