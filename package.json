{
  "name": "titanos",
  "engines": {
    "node": ">=22 <25"
  },
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p ./tsconfig.json --pretty false",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:share": "powershell -ExecutionPolicy Bypass -File scripts/prepare-apk-share.ps1",
    "android:sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-android-release.ps1",
    "ionos:package": "powershell -ExecutionPolicy Bypass -File scripts/package-ionos-web.ps1",
    "dealforge:package": "powershell -ExecutionPolicy Bypass -File dealnest/scripts/package-website.ps1",
    "cap:sync": "npm run build && npx cap sync android",
    "seed:owner": "node --env-file=.env.local scripts/seed-owner-account.mjs",
    "import:legacy-csv": "node scripts/import-legacy-csv.mjs",
    "purge:owner-seed": "node --env-file=.env.local scripts/purge-owner-seed.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "aab:fingerprint": "node scripts/aab-fingerprint.mjs",
    "ops:load": "node scripts/load-test.mjs",
    "ops:load:smoke": "node scripts/load-test.mjs --profile smoke",
    "ops:load:spike": "node scripts/load-test.mjs --profile spike",
    "ops:load:scale": "node scripts/load-test.mjs --profile scale",
    "ops:payments": "node scripts/payment-failure-scenarios.mjs",
    "ops:backup": "node scripts/backup-restore-drill.mjs --export",
    "ops:outage": "node scripts/outage-recovery-drill.mjs",
    "ops:readiness": "node scripts/payment-failure-scenarios.mjs && node scripts/backup-restore-drill.mjs --export && node scripts/outage-recovery-drill.mjs && node scripts/load-test.mjs --profile storm",
    "test:fees": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/fee-engine.test.mjs",
    "test:hire": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/hire-security.test.mjs",
    "test:payments": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/payment-security.test.mjs scripts/stripe-webhook-policy.test.mjs scripts/mpp-helpers.test.mjs scripts/autopilot-service.test.mjs",
    "test:driver": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/driver-hub.test.mjs scripts/vehicle-capacity.test.mjs scripts/driver-activity.test.mjs scripts/driver-intelligence.test.mjs scripts/driver-logbook.test.mjs scripts/driver-trip-journal.test.mjs scripts/driver-offer-analyzer.test.mjs scripts/driver-autopilot.test.mjs scripts/driver-voice.test.mjs scripts/driver-true-cost.test.mjs scripts/driver-coach.test.mjs scripts/driver-session-persist.test.mjs scripts/door-dash-workflow.test.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "test:money": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/money-document.test.mjs scripts/portal-otp.test.mjs",
    "test:tax": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/tax-engine.test.mjs",
    "test:hardening": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/production-hardening.test.mjs",
    "test:auth": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/auth-guards.test.mjs",
    "test:api": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/api-error.test.mjs",
    "test:comms": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/titancom-channels.test.mjs",
    "test:export": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/export-stack.test.mjs",
    "test:search": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/search-index.test.mjs",
    "test:settings": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/settings-catalog.test.mjs",
    "test:ai": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/ai-intents.test.mjs scripts/titan-ai-workflows.test.mjs scripts/titan-ai-summary.test.mjs scripts/titan-ai-api-contract.test.mjs",
    "test:gps": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/gps-owner.test.mjs",
    "test:offline": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/offline-local.test.mjs scripts/integration-offline.test.mjs",
    "test:a11y": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/a11y-smoke.test.mjs",
    "test:security": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/security-regression.test.mjs scripts/entitlements.test.mjs",
    "test:voice": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/voice-workflow.test.mjs scripts/driver-voice.test.mjs",
    "test:perf": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/perf-microbench.test.mjs",
    "test:maintainability": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/maintainability.test.mjs",
    "test:scalability": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/scalability.test.mjs",
    "test:code-quality": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/code-quality.test.mjs",
    "test:observability": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/observability.test.mjs",
    "test:regression": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/regression-wiring.test.mjs",
    "test:final-qa": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/final-qa.test.mjs",
    "test:integration-merge": "node --test scripts/integration-merge.test.mjs",
    "test:founding": "node --import ./scripts/node-test-setup.mjs --test-force-exit --test scripts/founding-beta.test.mjs",
    "grade:driver-hub": "npm run lint && npm run test:driver && npm run test:payments && npm run test:security && npm run test:hardening && npm run build",
    "test:db-security": "node scripts/verify-db-security.mjs",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:e2e:browsers": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test": "npm run test:fees && npm run test:hire && npm run test:payments && npm run test:driver && npm run test:money && npm run test:tax && npm run test:auth && npm run test:hardening && npm run test:api && npm run test:comms && npm run test:export && npm run test:search && npm run test:settings && npm run test:ai && npm run test:gps && npm run test:offline && npm run test:a11y && npm run test:security && npm run test:voice && npm run test:perf && npm run test:observability && npm run test:code-quality && npm run test:scalability && npm run test:maintainability && npm run test:integration-merge && npm run test:final-qa && npm run test:founding && npm run test:regression",
    "gate:ship": "npm run lint && npm run typecheck && npm run test:payments && npm run test:hardening && npm run test:security && npm run test:integration-merge && npm run test:final-qa && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "mppx": "^0.8.14",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "8.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.6.3",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.1",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
